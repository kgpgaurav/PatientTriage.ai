# Copy this file to .env and fill in your own key. Never commit the real .env.
#
# Optional — only needed to use the real OpenAI extraction backend in llm_extract.py.
# If unset, the pipeline automatically uses the heuristic (regex/negation) extractor.
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini


# Patient-data access control (see auth.py).
# Format: "key:role:name,key:role:name,...". Roles: nurse < clinician < admin.
# The name is per staff member, not per role -- do not share one key across
# multiple people, or the audit trail can only prove "a clinician did this,"
# never "which clinician." The name is technically optional ("key:role" still
# works) but strongly recommended for exactly that reason.
# If this is left unset entirely, the API runs "open" (no auth) for local
# demo convenience -- set it before any real/shared deployment.
TRIAGE_API_KEYS=nurse-demo-key:nurse:Anita,clinician-demo-key:clinician:Dr. Jetha,admin-demo-key:admin:M. Super

# Optional — comma-separated list of frontend origins allowed to call the API
# (CORS). Defaults to the standard Vite dev server ports if unset. Set this to
# your real frontend's origin(s) before any deployment beyond a laptop demo.
TRIAGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
