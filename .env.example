# Copy this file to .env and fill in your own key. Never commit the real .env.
#
# Optional — only needed to use the real OpenAI extraction backend in llm_extract.py.
# If unset, the pipeline automatically uses the heuristic (regex/negation) extractor.
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini


# Patient-data access control (see auth.py).
# Format: "key:role,key:role,...". Roles: nurse < clinician < admin.
# If this is left unset entirely, the API runs "open" (no auth) for local
# demo convenience -- set it before any real/shared deployment.
TRIAGE_API_KEYS=nurse-demo-key:nurse,clinician-demo-key:clinician,admin-demo-key:admin